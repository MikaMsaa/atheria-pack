    { "structure": "terralith:mage", "factor": 0 },
    { "structure": "terralith:rare_dungeon", "factor": 0 },
    { "structure": "terralith:underground_dungeon", "factor": 0 },
    { "structure": "repurposed_structures:ancient_cities_overworld", "factor": 0 },
