    }
   ],
   "choix": [
    {
     "texte": "Pour la sauver",
     "actions": [
      {
       "commande": "tag {joueur} add q_ch4_fundi"
      }
     ],
     "aller": "fundi_sauver"
    },
    {
     "texte": "Pour un remède",
     "actions": [
      {
       "commande": "tag {joueur} add q_ch4_fundi"
      }
     ],
     "aller": "fundi_remede"
    },
    {
     "texte": "Je ne sais pas",
     "actions": [
      {
       "commande": "tag {joueur} add q_ch4_fundi"
      },
      {
       "commande": "tag {joueur} add confiance_fundi"
      },
      {
       "commande": "scoreboard players add {joueur} aura_enfants 1"
      }
     ],
     "aller": "fundi_sais_pas"
    },
    {
     "texte": "Joyeux Anniversaire.",
     "actions": [
      {
       "commande": "tag {joueur} add q_ch4_fundi"
      },
      {
       "commande": "tag {joueur} add fundi_hostile"
      }
     ],
     "aller": "fundi_ratio"
    }
   ]
  },
  "fundi_sauver": {
   "lignes": [
    {
     "texte": "La sauver de quoi ? De nous, surtout."
    }
   ]
  },
  "fundi_remede": {
   "lignes": [
    {
     "texte": "Il te manque une phrase dans ton calcul. Elle s'appelle Hajar."
    }
   ]
  },
  "fundi_sais_pas": {
   "lignes": [
    {
     "texte": "(Il t'observe longtemps.) Enfin quelqu'un qui ne confond pas la certitude et le courage. Elle veut te parler."
    }
   ]
  },
  "fundi_ratio": {
   "lignes": [
    {
     "texte": "Joyeux Anniversaire. (Il se lève.) Si tu veux un ennemi, tu trouveras toujours quelqu'un pour jouer le rôle. Passe l'épreuve du souffle, ou affronte mes gardes."
    }
   ]
  },
  "fundi_apres": {
   "lignes": [
    {
     "texte": "Les Comocos respirent avec nous. Toi, tu respires trop fort. Apprends."
    }
   ]
  },
