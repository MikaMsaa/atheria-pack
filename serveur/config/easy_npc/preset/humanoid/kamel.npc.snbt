								},
								{
									Type: "CLOSE_DIALOG"
								}
							],
							Label: "b_q_ch1_kamel",
							Name: "Montrer le carnet"
						}
					],
					Conditions: [
						{
							Name: "q_ch1_checkpoint",
							Type: "PLAYER_TAG"
						}
					],
					Label: "q_ch1_kamel",
					Name: "q_ch1_kamel",
					Priority: 10,
					Texts: [
						{
							Text: "Baisse pas les yeux. Ici, c'est pas un concert. ...Attends. Ce carnet. Cette écriture. C'est celle de mon frère.\\n\\n— La PAF dit qu'il a été exécuté.\\n\\nLa PAF dit ce qui l'arrange. Rayade est parti vers le Bénara chercher l'origine de la voix. Il n'est jamais revenu. Alors qui ont-ils mis sur le quai ?"
						}
					]
				},
				{
					Conditions: [
						{
							Name: "q_ch1_kamel",
							Type: "PLAYER_TAG"
						}
					],
					Label: "q_ch1_kamel_fait",
					Name: "q_ch1_kamel (fait)",
					Priority: 11,
					Texts: [
						{
							Text: "Tu as ce qu'il te faut. Avance."
						}
					]
				},
				{
					Buttons: [
						{
							Actions: [
								{
									Cmd: "/tag @initiator add q_ch2_kamel",
									PermLevel: 2,
									Type: "COMMAND"
								},
								{
									Cmd: "/playsound minecraft:entity.experience_orb.pickup master @initiator ~ ~ ~ 0.6 1.2",
									PermLevel: 2,
									Type: "COMMAND"
								},
								{
									Type: "CLOSE_DIALOG"
								}
							],
							Label: "b_q_ch2_kamel",
							Name: "On y va"
						}
					],
					Conditions: [
						{
							Name: "acte_2",
							Type: "PLAYER_TAG"
						}
					],
					Label: "q_ch2_kamel",
					Name: "q_ch2_kamel",
					Priority: 12,
					Texts: [
						{
							Text: "Tu m'as vendu et tu viens me chercher. Je ne sais pas si tu es un salaud ou si tu as un sens de l'orientation catastrophique. On verra sur la route."
						}
					]
				},
				{
					Conditions: [
