					Name: "q_ch2_feu (fait)",
					Priority: 11,
					Texts: [
						{
							Text: "Tu as ce qu'il te faut. Avance."
						}
					]
				},
				{
					Label: "repos",
					Name: "Repos",
					Priority: 1,
					Texts: [
						{
							Text: "(Kamel tisonne le feu. Il parle à quelqu'un d'autre, pas à toi.)"
						}
					]
				}
