+            if (x > 0) v = Math.min(v, d[i - 1] + a);
+            if (z > 0) {
+                v = Math.min(v, d[i - w] + a);
+                if (x > 0) v = Math.min(v, d[i - w - 1] + b);
+                if (x < w - 1) v = Math.min(v, d[i - w + 1] + b);
+            }
+            d[i] = v;
+        }
+        for (int z = h - 1; z >= 0; z--) for (int x = w - 1; x >= 0; x--) {
+            int i = z * w + x; float v = d[i];
+            if (x < w - 1) v = Math.min(v, d[i + 1] + a);
